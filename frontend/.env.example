# ANTARIKSHA-RAKSHA frontend -- example environment (PLACEHOLDERS ONLY).
# Local dev: copy to frontend/.env.local (git-ignored). On Vercel, set these in
# Project > Settings > Environment Variables (Root Directory = frontend).

# --- Build-time (Vite; embedded in the public JS bundle -- never put secrets here)
# Unset           -> http://localhost:8000 (local development default)
# Empty string    -> same-origin: requests go to /api/* on the Vercel domain and
#                    vercel.json rewrites them to the api/proxy.js function,
#                    which proxies them to BACKEND_URL.
# Absolute URL    -> call that backend directly (needs CORS + cross-site cookies;
#                    not recommended -- prefer the same-origin proxy).
VITE_API_BASE_URL=
# Optional; must match backend ANTARIKSHA_API_KEY. Shared deployment key, visible
# in the bundle -- NOT a user credential.
VITE_API_KEY=

# --- Server-side (Vercel Functions only: api/proxy.js, api/cron/refresh.js)
# Persistent backend origin (no trailing slash), e.g. the VM/container URL.
BACKEND_URL=https://backend.example.com
# Optional (only if you add a Vercel Cron job on a plan that allows it):
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/refresh.
CRON_SECRET=replace-with-a-long-random-string
# Forwarded to the backend's /api/internal/scheduled-refresh; must equal the
# backend's SCHEDULER_SECRET.
SCHEDULER_SECRET=replace-with-another-long-random-string
