# ANTARIKSHA-RAKSHA -- example environment (PLACEHOLDERS ONLY).
# Copy to `.env` (git-ignored) or set these in your host's environment.
# Never commit real secrets. Every value below is a placeholder or a default.
# See docs/technical/DEPLOYMENT.md for the full deployment guide.

# =============================================================================
# BACKEND (Railway or another persistent host: `uvicorn backend.main:app`, see Dockerfile)
# =============================================================================
# SQLite database -- MUST live on a persistent volume in any deployment.
ANTARIKSHA_DB_PATH=/var/lib/antariksha/antariksha.db
# Cached CelesTrak downloads (persistent volume recommended).
ANTARIKSHA_TLE_CACHE_DIR=/var/lib/antariksha/tle_cache
# Comma-separated browser origins allowed by CORS / origin checks. Must include
# the Vercel domain when the Vercel /api proxy is used (it forwards Origin).
ANTARIKSHA_CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173
# CelesTrak catalog format: tle (default) | omm
ANTARIKSHA_CELESTRAK_FORMAT=tle

# =============================================================================
# AUTH / SESSIONS / RBAC
# =============================================================================
# true behind HTTPS (marks the session cookie Secure). false only for local http.
ANTARIKSHA_COOKIE_SECURE=true
ANTARIKSHA_SESSION_HOURS=12
# Optional extra deployment gate for mutating requests (header X-API-Key).
# Leave empty unless you need it; if set, the frontend must send the same value.
ANTARIKSHA_API_KEY=
# true = fail closed if ANTARIKSHA_API_KEY is required but not configured.
ANTARIKSHA_AUTH_REQUIRED=false
# One-time bootstrap of the first ADMINISTRATOR (only used while the users
# table is empty). Prefer `python -m backend.users create ...` instead and
# remove these after first start.
ANTARIKSHA_BOOTSTRAP_ADMIN_USERNAME=
ANTARIKSHA_BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# SCHEDULER (periodic public orbital-data refresh, every 2 h at even UTC hours)
# =============================================================================
# internal = in-process thread on the backend host (default)
# external = no thread; an external cron (e.g. optional Vercel Cron) calls the internal endpoint
# off      = automatic refresh disabled (manual refresh still works)
ANTARIKSHA_SCHEDULER_MODE=internal
# Only needed for ANTARIKSHA_SCHEDULER_MODE=external: shared secret for
# GET/POST /api/internal/scheduled-refresh (Authorization: Bearer <secret>);
# must equal SCHEDULER_SECRET on Vercel. Unset -> endpoint returns 503.
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET=replace-with-a-long-random-string

# =============================================================================
# AI BRIEFS (local Ollama only -- never expose Ollama publicly)
# =============================================================================
# ollama | disabled (use disabled on a deployed host without Ollama). Without a reachable Ollama the console shows
# AI FALLBACK ACTIVE and uses deterministic briefs (screening unaffected).
ANTARIKSHA_AI_MODE=ollama
ANTARIKSHA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
ANTARIKSHA_OLLAMA_MODEL=llama3.2:3b

# =============================================================================
# LOCAL TRANSLATION (optional; local IndicTrans2 model, no external API)
# =============================================================================
LOCAL_TRANSLATION_ENABLED=false
TRANSLATION_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
TRANSLATION_DEVICE=cpu
# Optional Hugging Face cache location for the local model files (standard HF vars):
# HF_HOME=/var/lib/antariksha/hf_home
# HF_HUB_CACHE=/var/lib/antariksha/hf_home/hub

# =============================================================================
# INGEST SAFETY
# =============================================================================
ANTARIKSHA_INGEST_MIN_GROUP_A_RESOLVED_FRACTION=0.5
ANTARIKSHA_INGEST_MAX_DEACTIVATE_FRACTION=0.5

# =============================================================================
# NOTIFICATIONS (optional Telegram alerts; backend secrets only -- never Vercel/Vite)
# =============================================================================
# Notification-only channel: cannot approve assessments, command a spacecraft
# or execute a maneuver. Off unless TELEGRAM_ENABLED=true (credentials alone
# do not enable sending). See docs/technical/DEPLOYMENT.md "Optional Telegram notifications".
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lowest existing risk tier that notifies: High (default) | Critical | Medium
TELEGRAM_MIN_RISK=High
# true = also notify DEMO events, labelled "DEMO — CONTROLLED SIMULATION"
TELEGRAM_NOTIFY_DEMO=false
# Optional https link to the public console included in alerts
ANTARIKSHA_PUBLIC_APP_URL=

# =============================================================================
# VERCEL FRONTEND PROJECT (set in Vercel > Project > Settings > Environment
# Variables; Root Directory = frontend). Listed here for reference only.
# =============================================================================
# Server-side (functions only, never exposed to the browser):
# BACKEND_URL=https://backend.example.com
# CRON_SECRET=replace-with-a-different-long-random-string
# SCHEDULER_SECRET=replace-with-a-long-random-string   (same as backend)
# Build-time (embedded in the static bundle):
# VITE_API_BASE_URL=          (empty = same-origin via the /api proxy)
# VITE_API_KEY=               (only if ANTARIKSHA_API_KEY is set; not a secret)
